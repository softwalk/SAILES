ATLANTIS_DATABASE_PORT=5432
ATLANTIS_DATABASE_NAME=atlantis
ATLANTIS_DATABASE_USER=atlantis_runtime
ATLANTIS_DATABASE_PASSWORD_FILE=/run/secrets/postgres_runtime_password
ATLANTIS_DATABASE_SSLMODE=verify-full
ATLANTIS_DATABASE_SSLROOTCERT=/run/secrets/postgres_ca
ATLANTIS_AMQP_URL=
