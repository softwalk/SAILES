# Copiar a /opt/atlantis/infrastructure/rc5-rollout.env y revisar antes de ejecutar.
ATLANTIS_ROOT=/opt/atlantis
ATLANTIS_EXPECTED_HOST=atlantis-core
ATLANTIS_EXPECTED_IP=192.168.100.160
ATLANTIS_MIN_MEMORY_KIB=7340032
ATLANTIS_MIN_AVAILABLE_MEMORY_KIB=2097152
ATLANTIS_MIN_DISK_KIB=10485760
ATLANTIS_DATABASE_HOST_FROM_VM=127.0.0.1
ATLANTIS_DATABASE_PORT=5432
ATLANTIS_DATABASE_NAME=atlantis
ATLANTIS_DATABASE_MIGRATOR_USER=atlantis_migrator
ATLANTIS_DATABASE_MIGRATOR_PASSWORD_HOST_FILE=/opt/atlantis/secrets/postgres_migrator_password.txt
ATLANTIS_DATABASE_PASSWORD_HOST_FILE=/opt/atlantis/secrets/postgres_runtime_password.txt
ATLANTIS_DATABASE_SSLMODE=verify-full
ATLANTIS_DATABASE_SSLROOTCERT_HOST=/opt/atlantis/secrets/postgres_ca.crt
ATLANTIS_BACKUP_ROOT=/opt/atlantis/backups/rc5
ATLANTIS_EVIDENCE_ROOT=/opt/atlantis/documentation/evidence/rc5
ATLANTIS_OIDC_PUBLIC_KEYS_HOST_FILE=/opt/atlantis/infrastructure/oidc/public_keys.json
ATLANTIS_CAMPAIGN_APPROVER_TOKEN_HOST_FILE=/run/atlantis/campaign_approver.token
ATLANTIS_HUMAN_REVIEWER_TOKEN_HOST_FILE=/run/atlantis/human_reviewer.token
ATLANTIS_MIGRATION_APPROVED_BY=
ATLANTIS_MIGRATION_APPROVED_DATE=
ATLANTIS_MIGRATION_EVIDENCE_FILE=/opt/atlantis/documentation/evidence/rc6/objetos-004-crudos.txt
ATLANTIS_MIGRATION_EVIDENCE_REF=documentation/evidence/rc6/objetos-004-crudos.txt
ATLANTIS_MIGRATION_EVIDENCE_SHA256=
ATLANTIS_SMOKE_TENANT_ID=
ATLANTIS_SMOKE_CONTACT_ID=
ATLANTIS_SMOKE_CAMPAIGN_VERSION_ID=
