ATLANTIS_ENV=production
ATLANTIS_RELEASE_TAG=0.9.0-rc4
ATLANTIS_SHADOW_MODE=true
ATLANTIS_CORE_IP=192.168.100.160
ATLANTIS_HERMES_BASE_URL=http://192.168.100.155:8000
ATLANTIS_DATABASE_HOST=postgres
ATLANTIS_DATABASE_PORT=5432
ATLANTIS_DATABASE_NAME=atlantis
ATLANTIS_DATABASE_USER=atlantis_runtime
ATLANTIS_DATABASE_PASSWORD_FILE=/run/secrets/postgres_runtime_password
ATLANTIS_DATABASE_SSLMODE=verify-full
ATLANTIS_DATABASE_SSLROOTCERT=/run/secrets/postgres_ca
ATLANTIS_CRM_STORAGE=postgres
ATLANTIS_CRM_EVIDENCE_URL=http://crm_api:8082
ATLANTIS_SHADOW_HTTP_ALLOWLIST=crm_api
ATLANTIS_INTERNAL_CA_FILE=/run/secrets/internal_ca
ATLANTIS_INTERNAL_CLIENT_CERT_FILE=/run/secrets/policy_client_cert
ATLANTIS_INTERNAL_CLIENT_KEY_FILE=/run/secrets/policy_client_key
ATLANTIS_REQUIRE_WORKLOAD_AUTH=true
ATLANTIS_REQUIRE_DURABLE_STATE=true
ATLANTIS_WORKLOAD_SECRETS_FILE=/run/secrets/workload_secrets
ATLANTIS_BIND_HOST=0.0.0.0
ATLANTIS_HTTP_READ_TIMEOUT_SECONDS=10
ATLANTIS_DECISION_MAX_AGE_SECONDS=120
ATLANTIS_TOKEN_ISSUER=atlantis-policy-gateway
ATLANTIS_WEBHOOK_TENANT_ID=
ATLANTIS_LITELLM_BASE_URL=http://litellm:4000/v1
KIMI_BASE_URL=http://litellm:4000/v1
KIMI_MODEL_ID=UNSET
KIMI_API_KEY_FILE=/run/secrets/kimi_litellm_key
DEEPSEEK_BASE_URL=http://litellm:4000/v1
DEEPSEEK_MODEL_ID=UNSET
DEEPSEEK_API_KEY_FILE=/run/secrets/deepseek_litellm_key
OPENOUTREACH_BIN=/opt/atlantis/opensource/openoutreach-runner/runner.sh
OPENOUTREACH_APPROVED_SHA256=
VOICE_PROVIDER=vicidial
VICIDIAL_API_URL=
VICIDIAL_API_USER=
VICIDIAL_API_PASSWORD_FILE=/run/secrets/vicidial_api_password
NEOBOT_API_URL=
NEOBOT_API_TOKEN_FILE=/run/secrets/neobot_api_token
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_VERSION=UNSET
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN_FILE=/run/secrets/meta_access_token
MARKETIA_BASE_URL=
MARKETIA_API_TOKEN_FILE=/run/secrets/marketia_api_token
PYTHON_BASE_IMAGE=python:3.12-slim-bookworm@sha256:a116514e19457bcb7af7efe9c3dd0b9b71e85b317694e7882a1c52aa15a78134
